{"version": 2, "width": 120, "height": 24, "timestamp": 1735689600, "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color", "LANG": "en_US.UTF-8"}, "title": "freshen — keep a developer machine current"}
[0.00, "o", "\r\n\u001b[1m\u001b[32mfreshen\u001b[0m \u001b[90m0.1.0\u001b[0m — one command to keep a developer machine current\r\n\u001b[90m~\u001b[0m $ \u001b[0m"]
[0.42, "i", "freshen --dry-run\r"]
[1.10, "o", "\r\n\u001b[1m==> Dry run: detecting tools, planning changes, changing nothing\u001b[0m\r\n\r\n\u001b[36mHomebrew\u001b[0m (detected at /opt/homebrew)\r\n  \u001b[90mbrew update\u001b[0m\r\n  \u001b[90mbrew upgrade --formula\u001b[0m — 3 formulae outdated\r\n  \u001b[90mbrew upgrade --cask\u001b[0m — 2 casks outdated (will quit and reopen 2 apps)\r\n\r\n\u001b[36mContainers\u001b[0m (Colima, running)\r\n  stop Colima → upgrade lima → start Colima → restore 4 containers\r\n\r\n\u001b[36muv\u001b[0m (detected)\r\n  \u001b[90muv tool upgrade --all\u001b[0m\r\n\r\n\u001b[36mmise\u001b[0m (detected)\r\n  \u001b[90mmise self-update\u001b[0m → \u001b[90mmise upgrade\u001b[0m\r\n\r\n\u001b[33mSkipped\u001b[0m: Mac App Store (no Apple Account signed in), uv (no outdated tools)\r\n\r\n\u001b[1mNo changes would be made.\u001b[0m Re-run without \u001b[93m--dry-run\u001b[0m to apply.\r\n\u001b[90m~\u001b[0m $ \u001b[0m"]
[2.05, "i", "freshen --check --json\r"]
[2.60, "o", "\r\n{\r\n  \"steps\": [\r\n    {\"id\": \"brew-formulae\", \"status\": \"ok\", \"current\": \"3.4.0\", \"new\": \"4.1.0\"},\r\n    {\"id\": \"brew-casks\", \"status\": \"skipped\", \"reason\": \"no casks to upgrade\"},\r\n    {\"id\": \"uv\", \"status\": \"ok\", \"current\": \"0.5.8\", \"new\": \"0.5.8\"},\r\n    {\"id\": \"mise\", \"status\": \"ok\", \"current\": \"2024.1.2\", \"new\": \"2024.1.2\"}\r\n  ],\r\n  \"exit_code\": 0,\r\n  \"updates_pending\": false\r\n}\r\n\u001b[90m~\u001b[0m $ \u001b[0m"]
